!public/login.html
!public/invite.html
!public/reset.html

# Logs
logs/
*.log

# k6 cloud results
cloud-results/

# Node modules
node_modules/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# k6 specific
.k6/

# Vite UI build output (generated by npm run build:ui)
public/dist/
public/index.bundled.html

