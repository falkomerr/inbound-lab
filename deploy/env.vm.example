# Copy to /opt/load-test-platform/.env on the VM and edit values.

NODE_ENV=production
UI_PORT=3001

# Required — generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# URL users type in the browser (VM IP, hostname, or domain)
APP_BASE_URL=http://YOUR_VM_IP:3001
ALLOWED_ORIGINS=http://YOUR_VM_IP:3001

# Behind nginx/HTTPS — uncomment:
# APP_BASE_URL=https://loadtest.yourcompany.com
# ALLOWED_ORIGINS=https://loadtest.yourcompany.com
# TRUST_PROXY=1

# MySQL (recommended for VM installs)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=loadtest
MYSQL_PASSWORD=REPLACE_MYSQL_PASSWORD
MYSQL_DATABASE=loadtest

# k6 targets (traffic originates FROM this VM)
ENV=staging
BASE_URL=https://httpbin.org

# Report retention on VM disk
REPORT_MAX_AGE_DAYS=14
REPORT_MAX_TOTAL_MB=2048
REPORT_MAX_FILE_MB=200

# Optional: HTTP access log for /api
# LOG_HTTP=1

# Monitoring: GET http://<host>:<UI_PORT>/api/health (no auth)
# UI requires npm install on the VM — Vue/Chart.js are served from node_modules
