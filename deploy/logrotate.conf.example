# /etc/logrotate.d/fastertest
# Copy and adjust paths if INSTALL_DIR is not /opt/fastertest
#
#   sudo cp deploy/logrotate.conf.example /etc/logrotate.d/fastertest
#
# Note: the UI server also prunes reports/ on startup via REPORT_* env vars.
# This logrotate config is an extra safety net for long-running VMs.

/opt/fastertest/logs/*.log {
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}

# Optional: compress stale large NDJSON/JSON artifacts if retention env is insufficient
/opt/fastertest/reports/* {
    weekly
    rotate 4
    compress
    delaycompress
    missingok
    notifempty
    maxage 30
}
