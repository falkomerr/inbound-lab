# =============================================================================
# FasterTest — environment template
# =============================================================================
#
# This file is documentation + a template. It is safe to commit.
#
# On a new machine:
#   cp env.example .env
#   # Edit .env — set JWT_SECRET and APP_BASE_URL / ALLOWED_ORIGINS
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Do NOT copy someone else's .env (secrets and users are per machine).
# data/users.json is also per machine when not using MySQL — run: npm run seed:admin
# With MySQL configured, users live in the database instead.
#
# =============================================================================

# -----------------------------------------------------------------------------
# UI server (Node) — REQUIRED for `npm run ui`
# -----------------------------------------------------------------------------

# Required. Server exits if unset. Generate a new value on each deployment.
JWT_SECRET=CHANGE_ME_generate_a_strong_random_secret

# URL users type in the browser (localhost, LAN IP, or domain)
APP_BASE_URL=http://localhost:3001

# Comma-separated origins allowed by CORS (must match how users open the UI)
ALLOWED_ORIGINS=http://localhost:3001

UI_PORT=3001

# production | development (affects log level defaults)
# NODE_ENV=production

# Use pre-built dashboard bundle (default when NODE_ENV=production and dist exists).
# Set to 0 to force dev import-map mode even in production.
# UI_USE_BUNDLE=1

# Set to 1 when behind nginx / a reverse proxy (HTTPS)
# TRUST_PROXY=1

# Optional: extra URLs for Content-Security-Policy connect-src (comma-separated)
# CSP_CONNECT_SRC_EXTRA=https://internal-api.example.com,wss://realtime.example.com

# Logging (server)
# LOG_LEVEL=debug
# LOG_PRETTY=1
# LOG_HTTP=1
# WS_LOG=silent

# -----------------------------------------------------------------------------
# First admin (optional — only for npm run seed:admin)
# -----------------------------------------------------------------------------
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# k6 target API (traffic runs FROM this machine)
# -----------------------------------------------------------------------------

ENV=staging
# Override default BASE_URL from config/config.js if needed:
# BASE_URL=https://httpbin.org
# Or point at your own API:
# BASE_URL=https://api.example.com/v1

API_TIMEOUT=30000
MAX_REDIRECTS=10

# Optional: restrict user/invite emails to one domain (omit to allow any email)
# ALLOWED_EMAIL_DOMAIN=example.com

# -----------------------------------------------------------------------------
# MySQL storage (users, invites, password resets, audit, access control)
# -----------------------------------------------------------------------------
#
# When MYSQL_HOST or MYSQL_URL is set, the server uses MySQL instead of data/*.json.
# Schema is created automatically on startup (npm run ui / seed:admin).
#
# Quick local DB:
#   docker compose up -d mysql
#
# Then either:
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=loadtest
MYSQL_PASSWORD=loadtest
MYSQL_DATABASE=loadtest
# MYSQL_POOL_SIZE=10
#
# Or a single URL:
# MYSQL_URL=mysql://loadtest:loadtest@127.0.0.1:3307/loadtest
#
# Force backend (optional): mysql | json
# STORAGE_BACKEND=mysql
#
# One-shot import of existing data/*.json:
#   npm run db:migrate-json

# Credentials passed into k6 scenarios (optional — for your own auth flows)
TEST_USER_PHONE=15550000001
TEST_USER_EMAIL=loadtest@example.com
# OTP for login-style scenarios — set your real value; never commit production secrets.
TEST_OTP=12345

# Default CLI load profile (UI can override per run)
VUS=10
DURATION=30s
RAMP_UP_TIME=10s
RAMP_DOWN_TIME=10s

RETRY_ATTEMPTS=3
RETRY_DELAY=1000
MIN_THINK_TIME=1000
MAX_THINK_TIME=3000

RATE_LIMIT_ENABLED=false
RATE_LIMIT_RPS=100

TEST_TYPE=load

# -----------------------------------------------------------------------------
# Reports (UI server disk cleanup under reports/)
# -----------------------------------------------------------------------------

REPORT_FORMAT=json
REPORT_PATH=reports/
REPORT_MAX_AGE_DAYS=14
REPORT_MAX_TOTAL_MB=2048
REPORT_MAX_FILE_MB=200

# -----------------------------------------------------------------------------
# Operations / monitoring
# -----------------------------------------------------------------------------
#
# Readiness (no auth): GET http://<host>:<UI_PORT>/api/health
#
# The UI serves Vue and Chart.js from node_modules — run `npm install` on every deploy.
# Audit log: MySQL `audit_log` table (or data/audit.json when MySQL is not configured).
# Server keeps the last 5000 entries.
# Optional VM log rotation: deploy/logrotate.conf.example

# Optional: HTTP access log for /api routes
# LOG_HTTP=1

# -----------------------------------------------------------------------------
# Optional integrations (not required for UI + k6)
# -----------------------------------------------------------------------------

ENABLE_METRICS=true
METRICS_INTERVAL=1000
ENABLE_SSL_VERIFY=true
TLS_VERSION=1.2

ENABLE_BASELINES=true
BASELINE_TOLERANCE=10

# Grafana
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=
GRAFANA_DASHBOARD_ID=
GRAFANA_DATASOURCE=k6

# InfluxDB (k6 --out influxdb=...)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_DATABASE=k6
INFLUXDB_USERNAME=
INFLUXDB_PASSWORD=
INFLUXDB_RETENTION_POLICY=autogen
INFLUXDB_PRECISION=ns
