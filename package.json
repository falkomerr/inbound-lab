{
  "name": "load-test-platform",
  "version": "1.0.0",
  "description": "Open-source k6 load and stress testing platform with a secure web UI",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "test:smoke": "k6 run --env ENV=staging --vus 5 --duration 1m tests/scenarios/sample-http-get.js",
    "test:load": "k6 run --env ENV=staging --vus 20 --duration 5m tests/scenarios/sample-http-get.js",
    "test:stress": "k6 run --env ENV=staging --vus 50 --duration 15m tests/scenarios/sample-http-get.js",
    "test:spike": "k6 run --env ENV=staging --vus 100 --duration 10m tests/scenarios/sample-http-get.js",
    "test:soak": "k6 run --env ENV=staging --vus 10 --duration 1h tests/scenarios/sample-http-get.js",
    "test:volume": "k6 run --env ENV=staging --vus 20 --duration 10m tests/scenarios/sample-http-get.js",
    "test:websocket": "echo 'Add a websocket-test.js scenario or use cURL import in the UI' && exit 1",
    "test:grpc": "echo 'Add a grpc-test.js scenario or use cURL import in the UI' && exit 1",
    "test:browser": "echo 'Add a browser-test.js scenario or use cURL import in the UI' && exit 1",
    "test:production": "k6 run --env ENV=production --vus 20 --duration 5m tests/scenarios/sample-http-get.js",
    "test:staging": "k6 run --env ENV=staging --vus 20 --duration 5m tests/scenarios/sample-http-get.js",
    "test:cloud": "k6 cloud tests/scenarios/sample-http-get.js",
    "test:all": "npm run test:smoke && npm run test:load && npm run test:stress",
    "test:quick": "npm run test:smoke",
    "test:full": "npm run test:smoke && npm run test:load && npm run test:stress && npm run test:spike",
    "report:html": "k6 run --out json=reports/results.json tests/scenarios/sample-http-get.js && node scripts/generate-html-report.js",
    "report:analyze": "node scripts/analyze-performance.js reports/results.json",
    "report:influxdb": "k6 run --out influxdb=http://localhost:8086/k6 tests/scenarios/sample-http-get.js",
    "report:cloud": "k6 cloud tests/scenarios/sample-http-get.js",
    "report:all": "npm run report:html && npm run report:analyze",
    "baseline:save": "node scripts/save-baseline.js reports/results.json",
    "baseline:compare": "node scripts/compare-baseline.js reports/results.json",
    "validate:config": "node -e \"import('./config/config.js').then(() => console.log('✅ Configuration validated successfully'))\"",
    "clean": "rm -rf reports/* logs/*",
    "clean:reports": "rm -rf reports/*",
    "clean:logs": "rm -rf logs/*",
    "setup": "npm install && npm run validate:config",
    "setup:env": "node scripts/setup-env.js",
    "install:k6": "node scripts/install-k6.js",
    "create:env": "node scripts/create-env-files.js",
    "ui:start": "node server/index.js",
    "ui": "npm run ui:start",
    "build:ui": "node scripts/build-ui.js",
    "ui:prod": "NODE_ENV=production node server/index.js",
    "seed:admin": "node scripts/seed-admin.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-concurrency=1 tests/unit/*.test.js tests/integration/*.test.js",
    "test:node": "npm run test",
    "test:k6": "npm run test:smoke",
    "test:watch": "node --test --watch tests/unit/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-concurrency=1 tests/unit/*.test.js tests/integration/*.test.js"
  },
  "keywords": [
    "load-testing",
    "stress-testing",
    "performance",
    "load-test",
    "stress-test",
    "k6",
    "api-testing",
    "performance-testing"
  ],
  "author": "Load Test Platform Contributors",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.4.0",
    "cors": "^2.8.5",
    "dotenv": "^17.1.0",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.14.0",
    "vue": "^3.5.13",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.1.3",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.2.5",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/load-test-platform.git"
  },
  "bugs": {
    "url": "https://github.com/YOUR_USERNAME/load-test-platform/issues"
  },
  "homepage": "https://github.com/YOUR_USERNAME/load-test-platform#readme"
}
