# Environment files (never commit secrets)
.env
.env.*
!.env.example

# Runtime data stores (users, invites, resets, audit — hashed passwords / tokens)
data/*
!data/.gitkeep

# Reports & logs
reports/
!reports/.gitkeep
logs/
!logs/.gitkeep
*.log
test-results/
coverage/

# Generic artifacts (keep package manifests)
!package.json
!package-lock.json
*.xml

# HTML files (ignore all except the main app pages)
!public/index.html
!public/login.html
!public/invite.html
!public/reset.html

# k6 cloud results
cloud-results/

# Node modules
node_modules/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# k6 specific
.k6/

# Vite UI build output (generated by npm run build:ui)
public/dist/
public/index.bundled.html

# Docker
*.tar
!ui/index.html
public/vpn/
!tests/docker/server.json
