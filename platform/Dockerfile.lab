FROM oven/bun:1.3.14-debian AS build
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .
RUN bun scripts/build-ui.js && bun --bun node_modules/vite/bin/vite.js build --config vite.vpn.config.js

FROM node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS runtime
WORKDIR /app
RUN addgroup -g 10001 lab && adduser -D -u 10001 -G lab lab
COPY --from=build --chown=lab:lab /app /app
RUN mkdir -p /app/data /app/logs /app/reports && chown -R lab:lab /app/data /app/logs /app/reports
ENV NODE_ENV=production VPN_ENABLED=1
USER lab
EXPOSE 3001
ENTRYPOINT ["node", "server/vpn/entry.js"]
CMD ["api"]
