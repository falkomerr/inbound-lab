# /etc/nginx/sites-available/loadtest
# Replace loadtest.example.com and proxy port if UI_PORT != 3001

upstream b2b_load_test {
    server 127.0.0.1:3001;
    keepalive 32;
}

server {
    listen 80;
    server_name loadtest.example.com;

    client_max_body_size 2m;

    # Readiness for load balancers / uptime monitors (no JWT required)
    location = /api/health {
        proxy_pass http://b2b_load_test;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        access_log off;
    }

    location / {
        proxy_pass http://b2b_load_test;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket (live metrics)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400s;
    }
}

# After certbot: use listen 443 ssl and set APP_BASE_URL / ALLOWED_ORIGINS to https://...
